# 复制为 .env 后填写（.env 放在 xwlb.py 同一目录）
# 只做 RSS 源时，只需要看第一段；WordPress 那段可以不填。

# ===== RSS 模式（python3 xwlb.py --rss）=====
# RSS 文件将来放在哪个网址下（feed.xml 所在目录），用于 RSS 里的自链接
RSS_LINK=https://你的域名.com/
# RSS 标题和简介
RSS_TITLE=每日新闻联播文字版
RSS_DESCRIPTION=每天的《新闻联播》全文文字稿，内容来自央视网。
# RSS 里保留最近多少天
RSS_ITEMS=30
# 抓取结果（每天一个 JSON）和 RSS 输出目录，相对路径以脚本所在目录为准
DATA_DIR=data
RSS_DIR=docs

# 文末是否附“来源：央视网《新闻联播》”链接（建议保留）
SOURCE_NOTE=true

# ===== WordPress 模式（python3 xwlb.py）=====
# WordPress 站点地址（不带结尾斜杠）
WP_URL=https://你的域名.com
# 用于发文章的 WordPress 用户名（需要“编辑”或“管理员”角色）
WP_USER=admin
# 应用程序密码：WordPress 后台 → 用户 → 个人资料 → 应用程序密码 → 新增
# 不是登录密码！带不带空格都可以
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 分类和标签（不存在会自动创建）
WP_CATEGORY=新闻联播文字版
WP_CATEGORY_SLUG=mrxwlb-text
WP_TAGS=新闻联播,联播文稿

# 文章状态：publish 直接发布 / draft 存草稿（先人工看一眼再发）
WP_POST_STATUS=publish

# 站点没开固定链接（访问 /wp-json/ 是 404）时改成 query
# WP_REST_PREFIX=query
